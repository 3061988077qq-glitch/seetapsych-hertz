---
import { site } from '../data/site';

interface Props { lang?: 'en' | 'zh'; }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
---

<article class="algorithm-card algorithm-card--adachrom" id="adachrom" aria-labelledby="adachrom-title">
  <header class="algorithm-card-header">
    <div class="algorithm-index" aria-hidden="true">02</div>
    <div>
      <p class="algorithm-kicker">{zh ? '无监督 · 信号处理' : 'UNSUPERVISED · SIGNAL PROCESSING'}</p>
      <h3 id="adachrom-title">AdaChrom</h3>
      <p>{zh
        ? 'AdaChrom 是一种无需标注训练数据的无监督 rPPG 心率估计方法。它从人脸 RGB 视频中定位可靠的皮肤区域，提取随脉搏变化的细微颜色信号，通过 CHROM 色度投影恢复血容量脉搏波形，最后利用 FFT 主频分析输出心率，为 TinyHR 之外提供一条轻量、可解释的开源方案。'
        : 'AdaChrom is an unsupervised rPPG heart-rate estimator that requires no labeled training data. It locates reliable skin regions in facial RGB video, extracts subtle pulse-related color changes, recovers a blood-volume-pulse waveform through CHROM chrominance projection, and estimates heart rate from the dominant FFT frequency, providing a lightweight and interpretable open-source alternative to TinyHR.'}</p>
    </div>
  </header>

  <figure>
    <img src={site.adachromPipelineUrl} alt={zh ? 'AdaChrom 流程：预处理、BVP 提取和心率后处理' : 'AdaChrom pipeline: preprocessing, BVP extraction, and heart-rate post-processing'} loading="lazy" width="1170" height="460" />
    <figcaption>{zh ? 'AdaChrom 流程图，摘自 SeetaPsych v1.0 技术报告第 10 页。' : 'AdaChrom pipeline, extracted from page 10 of the SeetaPsych v1.0 technical report.'}</figcaption>
  </figure>
</article>
