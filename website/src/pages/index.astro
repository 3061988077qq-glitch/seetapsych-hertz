---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import Demo from '../components/Demo.astro';
import Method from '../components/Method.astro';
import Results from '../components/Results.astro';
import Resources from '../components/Resources.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="HERTZ | Open-source heart-rate estimation from facial video"
  description="Explore the HERTZ collection of open-source rPPG estimators, including TinyHR and AdaChrom. Watch the demo, compare the methods, and access the code."
>
  <Header lang="en" />
  <main id="main">
    <Hero lang="en" />
    <Highlights lang="en" />
    <Demo lang="en" />
    <Method lang="en" />
    <Results lang="en" />
    <Resources lang="en" />
  </main>
  <Footer lang="en" />
</BaseLayout>
